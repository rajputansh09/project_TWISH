<!-- SIGN IN -->
<section class="tw-section-dark" style="min-height:80vh;display:flex;align-items:center;padding:4rem 0;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5">
        <div style="background:var(--tw-sage);border:1px solid rgba(162,123,92,0.25);border-radius:20px;padding:2.5rem;">
          <div class="text-center mb-4">
            <span style="font-family:var(--ff-heading);font-size:1.8rem;color:var(--tw-cream);">Twi<span style="color:var(--tw-gold);">sh</span></span>
            <p style="font-size:0.8rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--tw-gold);margin-top:0.5rem;margin-bottom:0;">Admin Access</p>
          </div>
          <% if (typeof error !== 'undefined' && error) { %>
          <div style="background:rgba(163,45,45,0.15);border:1px solid rgba(163,45,45,0.3);border-radius:8px;padding:0.75rem 1rem;margin-bottom:1.5rem;font-size:0.875rem;color:#F09595;">
            Incorrect password. Please try again.
          </div>
          <% } %>
          <form method="POST" action="/admin-login">
            <div class="mb-4">
              <label class="tw-label" for="password">Password</label>
              <input type="password" class="tw-form-control" id="password" name="password" placeholder="Enter admin password" required autofocus>
            </div>
            <button type="submit" class="btn-tw-primary" style="width:100%;">Sign In</button>
          </form>
          <div class="text-center mt-3">
            <a href="/home" style="font-size:0.85rem;color:rgba(220,215,201,0.5);">Back to site</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>