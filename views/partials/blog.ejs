<script>
function filterPosts(tag) {
  const cards = document.querySelectorAll('.blog-post-card');
  const btns = document.querySelectorAll('[id^="filter-"]');
  btns.forEach(b => { b.style.background='transparent'; b.style.color='var(--tw-forest)'; b.style.borderColor='rgba(44,57,48,0.2)'; });
  const active = document.getElementById('filter-'+tag);
  if (active) { active.style.background='var(--tw-forest)'; active.style.color='white'; active.style.borderColor='var(--tw-forest)'; }
  cards.forEach(card => {
    const tags = card.getAttribute('data-tags') || '';
    card.style.display = (tag==='all' || tags.includes(tag)) ? 'block' : 'none';
  });
}
</script>