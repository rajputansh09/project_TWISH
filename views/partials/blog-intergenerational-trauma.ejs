      <img src="/images/shimul-headshot 2.png" alt="Shimul Rajput" loading="lazy" style="width:64px;height:64px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(162,123,92,0.4);">
      <div>
