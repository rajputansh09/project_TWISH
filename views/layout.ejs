<body itemscope itemtype="https://schema.org/WebPage">
  <%- include("partials/header.ejs") %>
  <main itemprop="mainContentOfPage"><%- body %></main>
  <%- include("partials/footer.ejs") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Scroll fade observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('tw-visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.tw-fade, .tw-fade-left, .tw-fade-right, .tw-fade-scale').forEach(el => observer.observe(el));

    // Image loading — skeleton shimmer + smooth fade in
    // Fixes white page on mobile (images stuck at opacity:0)
    (function(){
      function loadImg(img){
        if(img.complete && img.naturalWidth > 0){
          img.classList.add('tw-loaded');
        } else {
          img.addEventListener('load', function(){ img.classList.add('tw-loaded'); }, {once:true});
          img.addEventListener('error', function(){ img.classList.add('tw-loaded'); }, {once:true});
        }
      }
      // Run immediately on all current images
      document.querySelectorAll('img').forEach(loadImg);
      // Run again after DOM ready
      document.addEventListener('DOMContentLoaded', function(){
        document.querySelectorAll('img').forEach(loadImg);
      });
      // Run again after full page load including lazy images
      window.addEventListener('load', function(){
        document.querySelectorAll('img').forEach(loadImg);
        // Safety net — force ALL images visible after 2.5s no matter what
        // This fixes mobile Safari where load events sometimes don't fire
        setTimeout(function(){
          document.querySelectorAll('img:not(.tw-loaded)').forEach(function(img){
            img.classList.add('tw-loaded');
          });
        }, 2500);
      });
      // Watch for dynamically added images
      new MutationObserver(function(mutations){
        mutations.forEach(function(m){
          m.addedNodes.forEach(function(node){
            if(node.nodeType !== 1) return;
            if(node.tagName === 'IMG') loadImg(node);
            node.querySelectorAll && node.querySelectorAll('img').forEach(loadImg);
          });
        });
      }).observe(document.body, {childList:true, subtree:true});
    })();
  </script>
</body>
