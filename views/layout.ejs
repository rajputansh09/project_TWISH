<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Twish — Therapy with Shimul Rajput, Registered Psychotherapist in Mississauga, Ontario.' %>">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'Twish — Therapy with Shimul' %>">
  <meta property="og:type" content="website">
  <meta name="robots" content="index, follow">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Twish — Therapy with Shimul' %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,600&family=DM+Sans:wght@300;400;500&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
  <%- include("partials/header.ejs") %>
  <main><%- body %></main>
  <%- include("partials/footer.ejs") %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('tw-visible'); observer.unobserve(e.target); } });
    }, { threshold: 0.08 });
    document.querySelectorAll('.tw-fade').forEach(el => observer.observe(el));
  </script>
</body>
</html>