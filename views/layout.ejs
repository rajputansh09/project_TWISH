  <script>
    // Scroll fade observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('tw-visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.tw-fade, .tw-fade-left, .tw-fade-right, .tw-fade-scale').forEach(el => observer.observe(el));

    // Image loading — skeleton shimmer + smooth fade in
    (function(){
      function loadImg(img){
        if(img.complete && img.naturalWidth > 0){
          img.classList.add('tw-loaded');
        } else {
          img.addEventListener('load', function(){ img.classList.add('tw-loaded'); }, {once:true});
          img.addEventListener('error', function(){ img.classList.add('tw-loaded'); }, {once:true});
        }
      }
      // Handle all current images
      document.querySelectorAll('img').forEach(loadImg);
      // Handle any images added dynamically
      new MutationObserver(function(mutations){
        mutations.forEach(function(m){
          m.addedNodes.forEach(function(node){
            if(node.nodeType !== 1) return;
            if(node.tagName === 'IMG') loadImg(node);
            node.querySelectorAll && node.querySelectorAll('img').forEach(loadImg);
          });
        });
      }).observe(document.body, {childList:true, subtree:true});
    })();
  </script>
